# Ground stack only (zenoh, fleet manager, bridge) for tests without simulated robots: a single local
# zenoh router (no outbound connects), wall-clock time, the robots of the simulation network config.
# Fake mission handlers can stand in for the robots: FAKE_ROBOTS="uav1" ./up.sh ground-only
USE_SIM_TIME=false
ZENOH_ROUTER_CONFIG=
NETWORK_CONFIG=./compose/simulation/config/network_config.yaml
