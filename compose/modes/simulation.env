# Local simulation; a single local zenoh router with the default config (no outbound connects).
USE_SIM_TIME=true
ZENOH_ROUTER_CONFIG=
NETWORK_CONFIG=./compose/simulation/config/network_config.yaml

RUN_TYPE=simulation
UAV_TYPE=x500
# must match compose/simulation/config/{simulator,network_config}.yaml
SIM_UAVS="uav14 uav16"
SIM_CONFIG_DIR=./compose/simulation/config
WORLD_CONFIG=./config/worlds/world_temesvar_field_123.yaml
