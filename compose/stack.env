# Common to all modes. Mode-specific variables live in modes/<mode>.env.
COMPOSE_PROJECT_NAME=ground
MRS_SYSTEM_IMAGE=ctumrs/mrs_uav_system:stable
RMW_IMPLEMENTATION=rmw_zenoh_cpp

ROOT_DIR=../

WORKSPACE_DIR=./holoswarm_ros_packages
CONFIG_DIR=./config
PROJ_DATA=/opt/proj_grids:/usr/share/proj

ROS_DOMAIN_ID=0
